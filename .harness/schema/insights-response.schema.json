{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "insights-response",
  "title": "InsightsResponse",
  "description": "Schema for the HTTP 200 success response from POST /api/insights",
  "type": "object",
  "required": ["status", "summary", "insights", "metadata"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["OK", "INSUFFICIENT_DATA", "REFUSED"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "insights": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/InsightItem"
      }
    },
    "metadata": {
      "type": "object",
      "required": ["activities_analysed", "source"],
      "additionalProperties": false,
      "properties": {
        "activities_analysed": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "InsightItem": {
      "type": "object",
      "required": ["metric", "text", "confidence", "evidence_activity_ids", "value", "unit"],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "ACTIVITY_COUNT",
            "TOTAL_DISTANCE_KM",
            "TOTAL_MOVING_TIME_MIN",
            "LONGEST_ACTIVITY_DISTANCE_KM",
            "DOMINANT_SPORT"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "confidence": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "evidence_activity_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "unit": {
          "type": "string",
          "enum": ["count", "km", "min", "sport"]
        }
      }
    }
  }
}
